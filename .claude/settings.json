{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew :core:jvmTest*)",
      "Bash(./gradlew :core:allTests*)",
      "Bash(./gradlew :core:compile*)",
      "Bash(./gradlew :app:shared:jvmTest*)",
      "Bash(./gradlew :app:shared:testAndroidHostTest*)",
      "Bash(./gradlew :app:shared:compile*)",
      "Bash(./gradlew :server:test*)",
      "Bash(./gradlew :server:compile*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(.claude/scripts/ci-digest.sh *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run rerun *)"
    ],
    "ask": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push * HEAD*)",
      "Bash(git push *:*)",
      "Bash(git push *+*)",
      "Bash(git push * -*)",
      "Bash(git push -f*)",
      "Bash(git push -d*)",
      "Bash(git push --force*)",
      "Bash(git push --delete*)"
    ],
    "deny": [
      "Bash(gh pr merge *--admin*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-main-fresh.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-pr-state.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
