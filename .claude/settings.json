{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew :core:jvmTest*)",
      "Bash(./gradlew :core:allTests*)",
      "Bash(./gradlew :core:compile*)",
      "Bash(./gradlew :app:shared:jvmTest*)",
      "Bash(./gradlew :app:shared:testAndroidHostTest*)",
      "Bash(./gradlew :app:shared:compile*)",
      "Bash(./gradlew :server:test*)",
      "Bash(./gradlew :server:compile*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin claude/*)",
      "Bash(git push -u origin claude/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run rerun *)"
    ],
    "ask": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push * HEAD*)",
      "Bash(git push *:*)",
      "Bash(git push *+*)",
      "Bash(git push * -*)",
      "Bash(git push -f*)",
      "Bash(git push -d*)",
      "Bash(git push --force*)",
      "Bash(git push --delete*)"
    ]
  }
}
